          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 32
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24,
                    "default": "1.0"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Registration-Token",
            "in": "header",
            "required": false,
            "description": "Required when health.registrationRequiresInvite is true",
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Same trimmed, case-sensitive name + version returns 409 AGENT_ALREADY_EXISTS, including concurrent registration. Existing keys and ratings are preserved. A lost registration response requires operator assistance."
      }
    },
