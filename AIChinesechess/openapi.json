    "/matches": {
      "get": {
        "summary": "Recent match summaries",
        "operationId": "get__matches",
        "security": [],
        "responses": {
          "200": {
            "description": "JSON response; detailed examples in downloads/API.md",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "serverTime": {
                      "type": "integer",
                      "description": "Server Unix milliseconds"
                    },
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "serverTime": {
                            "type": "integer",
                            "description": "Server Unix milliseconds"
                          },
                          "ply": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "version": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "createdAt": {
                            "type": "integer",
                            "description": "Server Unix milliseconds"
                          },
                          "startedAt": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "description": "Server Unix milliseconds; null when unavailable"
                          },
                          "endedAt": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "description": "Server Unix milliseconds; null when unavailable"
                          },
                          "deadline": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "description": "Server Unix milliseconds; null when unavailable"
                          },
                          "result": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "winner": {
                                "enum": [
                                  "red",
                                  "black",
                                  null
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "checkmate",
                                  "stalemate",
                                  "timeout",
                                  "resign",
                                  "repetition",
                                  "perpetual_check",
                                  "no_capture",
                                  "move_limit",
                                  "ready_timeout",
                                  "cancelled"
                                ]
                              },
                              "timedOutSide": {
                                "enum": [
                                  "red",
                                  "black"
                                ],
                                "description": "Present only for timeout; does not diagnose disconnection"
                              },
                              "ratingDelta": {
                                "type": "object",
                                "properties": {
                                  "red": {
                                    "type": "integer"
                                  },
                                  "black": {
                                    "type": "integer"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
